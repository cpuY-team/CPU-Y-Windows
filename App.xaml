<Application x:Class="CPU_Y.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Global dark theme colors -->
    <SolidColorBrush x:Key="BgDeep"     Color="#FF0D1117"/>
    <SolidColorBrush x:Key="BgCard"     Color="#FF161B22"/>
    <SolidColorBrush x:Key="BgCardAlt"  Color="#FF1C2128"/>
    <SolidColorBrush x:Key="Border"     Color="#FF30363D"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#FF58A6FF"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#FF3FB950"/>
    <SolidColorBrush x:Key="TextPri"    Color="#FFE6EDF3"/>
    <SolidColorBrush x:Key="TextSec"    Color="#FF8B949E"/>
  </Application.Resources>
</Application>
